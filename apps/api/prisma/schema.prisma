// IAM persistence model (Domain Model, TS-IAM-001). Prisma is an infrastructure detail:
// nothing generated from this file may be imported from domain/ or application/.

generator client {
  provider     = "prisma-client"
  output       = "../src/platform/database/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PasswordResetTokenStatus {
  ACTIVE
  USED
  EXPIRED
  SUPERSEDED
}

model User {
  id              String     @id @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  role            UserRole
  status          UserStatus
  termsAcceptedAt DateTime   @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion    String     @map("terms_version")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile             UserProfile?
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserProfile {
  id                  String   @id @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  hasSeenWelcome      Boolean  @default(false) @map("has_seen_welcome")
  matchingPreferences Json?    @map("matching_preferences")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String        @id @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @map("refresh_token_hash")
  status           SessionStatus
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// TS-IAM-004: only the SHA-256 of the emailed token is stored, never the token itself.
model PasswordResetToken {
  id        String                   @id @db.Uuid
  userId    String                   @map("user_id") @db.Uuid
  tokenHash String                   @unique @map("token_hash")
  status    PasswordResetTokenStatus
  expiresAt DateTime                 @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?                @map("used_at") @db.Timestamptz(3)
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Animals persistence model (Domain Model — Animals domain, Taxonomy).
enum Species {
  DOG
  CAT
  OTHER
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
}

enum AgeGroup {
  PUPPY_KITTEN
  YOUNG
  ADULT
  SENIOR
}

enum Temperament {
  CALM
  PLAYFUL
  ENERGETIC
  SHY
  AFFECTIONATE
  INDEPENDENT
}

enum AnimalStatus {
  AVAILABLE
  RESERVED
  ADOPTED
}

// MVP: exactly one row, "YouPetMe", inserted by the animals migration.
model Shelter {
  id          String   @id @db.Uuid
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  animals Animal[]

  @@map("shelters")
}

model Animal {
  id                         String        @id @db.Uuid
  shelterId                  String        @map("shelter_id") @db.Uuid
  name                       String
  species                    Species
  size                       AnimalSize
  ageGroup                   AgeGroup      @map("age_group")
  breed                      String?
  temperament                Temperament[]
  compatibleWithChildren     Boolean?      @map("compatible_with_children")
  compatibleWithOtherAnimals Boolean?      @map("compatible_with_other_animals")
  careNotes                  String?       @map("care_notes")
  // References only (https URLs in the MVP); the domain knows nothing about where they live.
  photoUrls                  String[]      @map("photo_urls")
  status                     AnimalStatus
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("animals")
}
