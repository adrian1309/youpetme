# YouPetMe environment template (ARCH-001).
# Copy to .env and fill in real values locally. Never commit .env.
# All values below are fictitious placeholders.

# --- Local infrastructure (infra/docker) ---
# Credentials for the local PostgreSQL container only.
POSTGRES_USER=youpetme
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=youpetme

# --- API ---
# PostgreSQL connection string used by the API (Prisma).
DATABASE_URL=postgresql://youpetme:change-me-local-only@localhost:5432/youpetme?schema=public
# Port the API listens on.
API_PORT=3000
# Allowed browser origin for CORS (the web app URL).
WEB_ORIGIN=http://localhost:5173

# --- Authentication (ADR-002) ---
# Long random secrets (at least 32 characters); the project owner provides real values in .env, never committed.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Registration and refresh-token cookie (TS-IAM-001) ---
# Version of the Terms of Service and Privacy Policy texts accepted at registration.
# EXAMPLE VALUE ONLY: set the real version of the published texts before production.
# The /terms and /privacy pages must show this same version (SCRUM-47).
TERMS_VERSION=example-version-replace-me
# Refresh-token cookie attributes (HttpOnly is always on; Path is /api/v1/auth).
# COOKIE_SECURE=false only for local development over http://localhost.
COOKIE_SECURE=false
# Strict | Lax | None (None requires COOKIE_SECURE=true).
COOKIE_SAMESITE=Strict

# --- Web (apps/web) ---
# Origin of the API the browser talks to. Only variables prefixed VITE_ reach the browser;
# never put a secret behind that prefix.
VITE_API_URL=http://localhost:3000
