# YouPetMe environment template (ARCH-001).
# Copy to .env and fill in real values locally. Never commit .env.
# All values below are fictitious placeholders.

# --- Local infrastructure (infra/docker) ---
# Credentials for the local PostgreSQL container only.
POSTGRES_USER=youpetme
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=youpetme

# --- API ---
# PostgreSQL connection string used by the API (Prisma).
DATABASE_URL=postgresql://youpetme:change-me-local-only@localhost:5432/youpetme?schema=public
# Port the API listens on.
API_PORT=3000
# Allowed browser origin for CORS (the web app URL).
WEB_ORIGIN=http://localhost:5173

# --- Authentication (ADR-002) ---
# Long random secrets; provided by the project owner, never generated by tooling.
JWT_ACCESS_SECRET=18fae53b2666aa9c4842159be02d125f7a654f375fc24a61f34cf8dc54c303aa13eb81ee62676ca6fee6ca8fbdcc3e1a
JWT_REFRESH_SECRET=4d21faed6fd7cd118201ed1f58379a20f045de7930fee1b7f8468fe05e311aad5b19b94923db91f824e68f283648c6f4
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
