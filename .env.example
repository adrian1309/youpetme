# YouPetMe environment template (ARCH-001).
# Copy to .env and fill in real values locally. Never commit .env.
# All values below are fictitious placeholders.

# --- Local infrastructure (infra/docker) ---
# Credentials for the local PostgreSQL container only.
POSTGRES_USER=youpetme
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=youpetme
# Optional host port for PostgreSQL. Defaults to 5432; the E2E stack uses its own (5433).
# POSTGRES_PORT=5432

# --- API ---
# PostgreSQL connection string used by the API (Prisma).
DATABASE_URL=postgresql://youpetme:change-me-local-only@localhost:5432/youpetme?schema=public
# Port the API listens on.
API_PORT=3000
# Allowed browser origin for CORS (the web app URL).
WEB_ORIGIN=http://localhost:5173

# --- Authentication (ADR-002) ---
# Long random secrets (at least 32 characters); the project owner provides real values in .env, never committed.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Absolute lifetime of a session from sign-in, however often it is refreshed (SCRUM-54).
# Optional: defaults to 30d. Must be at least JWT_REFRESH_EXPIRATION.
SESSION_ABSOLUTE_EXPIRATION=30d

# --- Registration and refresh-token cookie (TS-IAM-001) ---
# Version of the Terms of Service and Privacy Policy texts accepted at registration.
# EXAMPLE VALUE ONLY: set the real version of the published texts before production.
# The /terms and /privacy pages must show this same version (SCRUM-47).
TERMS_VERSION=example-version-replace-me
# Refresh-token cookie attributes (HttpOnly is always on; Path is /api/v1/auth).
# COOKIE_SECURE=false only for local development over http://localhost.
COOKIE_SECURE=false
# Strict | Lax | None (None requires COOKIE_SECURE=true).
COOKIE_SAMESITE=Strict

# --- Email and password recovery (ADR-014, TS-IAM-004) ---
# How transactional emails leave the API:
#   console  development: prints each email, reset link included, to the API log (default).
#   file     automated tests: writes each email as JSON into EMAIL_OUTBOX_DIR.
#   resend   sends through Resend. The only value accepted with NODE_ENV=production.
EMAIL_DELIVERY=console
# Required with EMAIL_DELIVERY=resend. A Resend API key with sending access; never commit a real one.
# RESEND_API_KEY=re_change-me
# Required with EMAIL_DELIVERY=resend. Sender on a domain verified in Resend.
# EMAIL_FROM="YouPetMe <no-reply@example.com>"
# Required with EMAIL_DELIVERY=file. Folder the emails are written to.
# EMAIL_OUTBOX_DIR=/tmp/youpetme-outbox
# Lifetime of a password reset link. Optional: defaults to 2h. Same format as the durations above.
PASSWORD_RESET_EXPIRATION=2h

# --- First ADMIN account (pnpm --filter @youpetme/api seed:admin) ---
# Read only by the seed script; ADMIN accounts are never created by registration.
# Set your own values in .env; never commit them. Running the seed again changes nothing.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-admin-password
# Optional; default "Admin" and "YouPetMe".
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=YouPetMe

# --- Web (apps/web) ---
# Origin of the API the browser talks to. Optional in development (defaults to
# http://localhost:3000); mandatory when building for production. Only variables prefixed
# VITE_ reach the browser; never put a secret behind that prefix.
VITE_API_URL=http://localhost:3000
